# Sonoran Sims — environment variables
# Copy to .env.local for local dev:  cp .env.example .env.local

# Public site URL (used for SEO / Open Graph). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://sonoransims.com

# BOOKING EMAIL (activates the built-in /api/book endpoint).
# The "Book" modal already POSTs every booking to /api/book. Set these to have
# it email each booking to your inbox via Resend (https://resend.com — free tier).
# Without RESEND_API_KEY the site still works; bookings are logged server-side
# (delivered:false) instead of emailed.
RESEND_API_KEY=re_YOUR_KEY_HERE
BOOKING_NOTIFY_EMAIL=hello@sonoransims.com
# Use onboarding@resend.dev for testing; switch to your verified domain for production:
BOOKING_FROM=Sonoran Sims <bookings@sonoransims.com>

# Alternatively, skip email entirely and point buttons at Calendly/Square by
# setting config.bookingUrl in lib/content.ts (no env vars needed).
